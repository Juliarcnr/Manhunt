rules_version = '2';

// Manhunt security rules. Sensitive values (names, settings, locations) are
// end-to-end encrypted on the device; these rules only control who may
// read/write which documents. Tests: firestore-tests/rules.test.mjs
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function gamePath(gid) {
      return /databases/$(database)/documents/games/$(gid);
    }

    function game(gid) {
      return get(gamePath(gid)).data;
    }

    function isAdmin(gid) {
      return signedIn() && game(gid).adminUid == request.auth.uid;
    }

    function isMember(gid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/games/$(gid)/members/$(request.auth.uid));
    }

    function myMember(gid) {
      return get(/databases/$(database)/documents/games/$(gid)/members/$(request.auth.uid)).data;
    }

    function isHunter(gid) {
      return isMember(gid) && myMember(gid).role == 'hunter';
    }

    function isPlayer(gid) {
      return isMember(gid) && myMember(gid).role == 'player';
    }

    // Plays no part, watches everyone live (R-GM-01, R-GM-03).
    function isGameMaster(gid) {
      return isMember(gid) && myMember(gid).role == 'gameMaster';
    }

    // A caught player may watch like a game master (R-GM-07).
    function isCaughtPlayer(gid) {
      return isPlayer(gid) && myMember(gid).get('caught', false) == true;
    }

    // Only while a round runs: back in the lobby nobody watches anything.
    function watchesLive(gid) {
      return isRunning(gid) && (isGameMaster(gid) || isCaughtPlayer(gid));
    }

    function isRunning(gid) {
      return game(gid).status == 'running';
    }

    // The round's time is up or the hunters caught everyone (R-GAME-06,
    // R-GAME-08), but the host has not ended it yet: everyone may look at all
    // positions. `durationSec` is the plain copy of the encrypted duration.
    function roundOver(gid) {
      let g = game(gid);
      return g.status == 'running' && g.get('startAt', null) is timestamp
        && (finishedThisRound(g)
          || (g.get('durationSec', null) is int
            && request.time >= g.startAt + duration.value(g.durationSec, 's')));
    }

    // A finishedAt from before the start is a leftover of an earlier round
    // (ended by an older app that did not clear it) and does not count.
    function finishedThisRound(g) {
      return g.get('finishedAt', null) is timestamp
        && g.get('startAt', null) is timestamp
        && g.finishedAt >= g.startAt;
    }

    // The round's planned time is up (R-GAME-01). [g]: the game's data.
    function timeUp(g) {
      return g.status == 'running' && g.get('startAt', null) is timestamp
        && g.get('durationSec', null) is int
        && request.time >= g.startAt + duration.value(g.durationSec, 's');
    }

    // Someone confirmed this round, after the time was up, who else was
    // caught (R-GAME-11). One from before the end is a leftover.
    function confirmedThisRound(g) {
      return g.get('confirmedAt', null) is timestamp
        && g.get('startAt', null) is timestamp
        && g.get('durationSec', null) is int
        && g.confirmedAt >= g.startAt + duration.value(g.durationSec, 's');
    }

    // After the time is up, the hunters or the players still in the game –
    // not caught ones – are asked who else was caught (R-GAME-11).
    function confirmsTimeUp(gid) {
      return isHunter(gid) || (isPlayer(gid) && myMember(gid).get('caught', false) == false);
    }

    // The round has been decided for 15 s: any member may end it and save it
    // to the history (R-GAME-10, no server). Decided: by the hunters' win,
    // after the time is up by the confirmation (R-GAME-11), or without one
    // 10 min after the time is up. [g] is the game's data before the request.
    function autoEndDue(g) {
      return g.status == 'running' && g.get('startAt', null) is timestamp
        && g.get('durationSec', null) is int
        && ((finishedThisRound(g) && request.time >= g.finishedAt + duration.value(15, 's'))
          || (!finishedThisRound(g) && confirmedThisRound(g)
            && request.time >= g.confirmedAt + duration.value(15, 's'))
          || request.time >= g.startAt + duration.value(g.durationSec, 's')
            + duration.value(10, 'm') + duration.value(15, 's'));
    }

    function canAutoEnd(gid) {
      return isMember(gid) && autoEndDue(game(gid));
    }

    // A player who just used the joker may read hunter positions for 2 minutes.
    function jokerWindowOpen(gid) {
      return isPlayer(gid)
        && myMember(gid).get('jokerAt', null) != null
        && myMember(gid).jokerAt > request.time - duration.value(2, 'm');
    }

    // At most 180 days (+1 day clock tolerance) into the future.
    function validExpiry() {
      return request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(181, 'd');
    }

    // 180 days without anyone opening the group: any member may clean up (no server, no TTL).
    function isExpired(gid) {
      return signedIn() && game(gid).expiresAt < request.time;
    }

    function isRoundCollection(name) {
      return name in [
        'pings', 'hunterLocs', 'outsideLocs', 'playerLocs', 'events', 'speedhuntTargets', 'jokerRequests',
        'jokerAnswers', 'drawings', 'hunterSnaps'
      ];
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /games/{gid} {
      // The id is derived from the secret code, so knowing it = being invited.
      // Needed before joining to check the group exists; content is encrypted.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['adminUid', 'status', 'name', 'settings', 'area', 'sharedPings', 'durationSec', 'hunterJokers', 'startAt', 'createdAt', 'expiresAt'])
        // Group name (R-GROUPS-04) is optional and encrypted.
        && request.resource.data.get('name', '') is string
        // "Regular pings to all players" (R-SET-15), plain for the ping rules.
        && request.resource.data.get('sharedPings', false) is bool
        // Plain round duration for roundOver().
        && request.resource.data.get('durationSec', 0) is int
        // Plain number of hunter jokers per player (R-SET-09).
        && request.resource.data.get('hunterJokers', 1) is int
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.settings is string
        && request.resource.data.expiresAt is timestamp;

      allow update: if (isAdmin(gid)
          && request.resource.data.adminUid == resource.data.adminUid
          && request.resource.data.status in ['lobby', 'running']
          && request.resource.data.get('name', '') is string
          && request.resource.data.get('sharedPings', false) is bool
          && request.resource.data.get('hunterJokers', 1) is int
          // The confirmation after the time is up only like everyone else
          // (below, R-GAME-11); the host may only clear it.
          && (request.resource.data.get('confirmedAt', null) == resource.data.get('confirmedAt', null)
            || !('confirmedAt' in request.resource.data))
          && validExpiry())
        // Any member opening the group extends its lifetime (R-PRIV-05).
        || (isMember(gid) && onlyChanges(['expiresAt']) && validExpiry())
        // Catching the last player: the hunters won (R-GAME-08). Once, by a
        // hunter or by the player reporting their own catch in the same batch –
        // so no player can unlock all positions while still in the game.
        || (isRunning(gid) && onlyChanges(['finishedAt'])
            && !finishedThisRound(resource.data)
            && request.resource.data.finishedAt == request.time
            && (isHunter(gid)
              || (isPlayer(gid) && myMember(gid).caught == false
                && getAfter(/databases/$(database)/documents/games/$(gid)/members/$(request.auth.uid))
                     .data.caught == true)))
        // After the time is up: who else was caught is confirmed (R-GAME-11).
        // Once per round, by a hunter or a player still in the game (before
        // the batch: they may report their own catch with it), timestamped
        // by the server; not after the hunters' win.
        || (timeUp(resource.data) && onlyChanges(['confirmedAt'])
            && !finishedThisRound(resource.data)
            && !confirmedThisRound(resource.data)
            && request.resource.data.confirmedAt == request.time
            && confirmsTimeUp(gid))
        // Any member may edit the (encrypted) play area while in the lobby (R-SET-10).
        || (isMember(gid) && resource.data.status == 'lobby'
            && onlyChanges(['area', 'expiresAt'])
            && request.resource.data.area is string && validExpiry())
        // Automatic end (R-GAME-10): back to the lobby exactly as the host does.
        || (isMember(gid) && autoEndDue(resource.data)
            && onlyChanges(['status', 'startAt', 'finishedAt', 'confirmedAt', 'aliases', 'expiresAt'])
            && request.resource.data.status == 'lobby'
            && request.resource.data.startAt == null
            && !('finishedAt' in request.resource.data)
            && !('confirmedAt' in request.resource.data)
            && !('aliases' in request.resource.data)
            && validExpiry());

      allow delete: if isAdmin(gid) || isExpired(gid);

      match /members/{uid} {
        allow get: if isMember(gid) || (signedIn() && request.auth.uid == uid);
        allow list: if isMember(gid);

        // Joining is possible in the lobby and during a round (lost phone).
        allow create: if signedIn()
          && request.auth.uid == uid
          && exists(gamePath(gid))
          && request.resource.data.keys().hasOnly(
               ['name', 'role', 'caught', 'jokerUsed', 'joinedAt'])
          && request.resource.data.name is string
          && request.resource.data.role == 'unassigned'
          && request.resource.data.caught == false
          && request.resource.data.jokerUsed == false;

        // Host: roles + reset of caught/joker at round end. Self: own name.
        allow update: if
          (isAdmin(gid) && onlyChanges(['role', 'caught', 'jokerUsed', 'jokersUsed', 'playerJokerUsed'])
            && request.resource.data.role in ['unassigned', 'hunter', 'player', 'gameMaster'])
          || (signedIn() && request.auth.uid == uid && onlyChanges(['name']))
          // Automatic end (R-GAME-10): any member resets like the host.
          || (canAutoEnd(gid) && onlyChanges(['caught', 'jokerUsed', 'jokersUsed', 'playerJokerUsed'])
            && request.resource.data.caught == false
            && request.resource.data.jokerUsed == false
            && request.resource.data.get('jokersUsed', 0) == 0
            && request.resource.data.get('playerJokerUsed', false) == false)
          // Catch (R-CATCH-01): a hunter marks a player, or the player themself.
          || (isRunning(gid) && onlyChanges(['caught'])
            && resource.data.role == 'player'
            && request.resource.data.caught == true
            && (isHunter(gid) || request.auth.uid == uid))
          // Who else was caught, reported after the time is up (R-GAME-11):
          // also by a player still in the game for others, but only together
          // with the confirmation (same batch, same server time).
          || (isRunning(gid) && onlyChanges(['caught'])
            && resource.data.role == 'player'
            && request.resource.data.caught == true
            && confirmsTimeUp(gid)
            && getAfter(gamePath(gid)).data.get('confirmedAt', null) == request.time)
          // Hunter joker (R-PLAY-02): as often per round as the settings allow
          // (R-SET-09), one at a time, timestamped by the server.
          || (isRunning(gid) && signedIn() && request.auth.uid == uid
            && onlyChanges(['jokersUsed', 'jokerAt'])
            && resource.data.role == 'player'
            && request.resource.data.jokersUsed == resource.data.get('jokersUsed', 0) + 1
            && request.resource.data.jokersUsed <= game(gid).get('hunterJokers', 1)
            && request.resource.data.jokerAt == request.time)
          // Same for app versions before R-SET-09 allowed several: once.
          || (isRunning(gid) && signedIn() && request.auth.uid == uid
            && onlyChanges(['jokerUsed', 'jokerAt'])
            && resource.data.role == 'player'
            && game(gid).get('hunterJokers', 1) >= 1
            && resource.data.jokerUsed == false
            && request.resource.data.jokerUsed == true
            && request.resource.data.jokerAt == request.time)
          // Joker "player positions" (R-PLAY-03): once per round, same pattern.
          || (isRunning(gid) && signedIn() && request.auth.uid == uid
            && onlyChanges(['playerJokerUsed', 'playerJokerAt'])
            && resource.data.role == 'player'
            && resource.data.get('playerJokerUsed', false) == false
            && request.resource.data.playerJokerUsed == true
            && request.resource.data.playerJokerAt == request.time);

        allow delete: if (signedIn() && request.auth.uid == uid)
          || isAdmin(gid) || isExpired(gid);
      }

      // Per-round data, deleted by the host at round end (R-PRIV-03) or by
      // anyone after expiry. Reading is defined per collection below.
      match /{roundCollection}/{docId} {
        // To delete, the docs must be found first: the host may read leftovers
        // only while no round runs (nothing left to cheat with), anyone after
        // expiry, any member once the round is due to end automatically
        // (R-GAME-10; everyone has been able to see all positions since the
        // round was over).
        // During a round reading is defined per collection below.
        allow read: if isRoundCollection(roundCollection)
          && (isExpired(gid) || (isAdmin(gid) && game(gid).status == 'lobby')
            || canAutoEnd(gid));
        allow delete: if isRoundCollection(roundCollection)
          && (isAdmin(gid) || isExpired(gid) || canAutoEnd(gid));
      }

      // Location pings of players (R-PING-01). Hunters read all, players
      // only their own (R-HUNT-03, R-PLAY-01) – or, if the host lets the
      // regular pings go to everyone, all regular ones; never speedhunt pings
      // (R-SET-15, R-SPEED-04). Once the round is over, players read all
      // (R-GAME-06). Game masters and caught players read all (R-GM-03,
      // R-GM-07). One doc per slot, never edited.
      match /pings/{pingId} {
        allow read: if isHunter(gid) || watchesLive(gid)
          || (isPlayer(gid) && roundOver(gid))
          || (isMember(gid) && resource.data.uid == request.auth.uid)
          || (isPlayer(gid) && game(gid).get('sharedPings', false) == true
            && resource.data.kind == 'regular');
        allow create: if isRunning(gid) && isPlayer(gid)
          && request.resource.data.keys().hasOnly(['uid', 'kind', 'slot', 'createdAt', 'data'])
          && request.resource.data.uid == request.auth.uid
          && pingId == request.auth.uid + '_' + request.resource.data.slot
          && request.resource.data.kind in ['regular', 'speedhunt']
          && request.resource.data.data is string;
      }

      // Live hunter positions (R-HUNT-02): hunters only; a player right after
      // using their joker may read them once (R-PLAY-02), all players once the
      // round is over (R-GAME-06), game masters and caught players always
      // (R-GM-03, R-GM-07).
      match /hunterLocs/{hunterId} {
        allow read: if isHunter(gid) || jokerWindowOpen(gid) || watchesLive(gid)
          || (isPlayer(gid) && roundOver(gid));
        allow create, update: if isRunning(gid) && isHunter(gid)
          && request.auth.uid == hunterId
          && request.resource.data.keys().hasOnly(['updatedAt', 'data'])
          && request.resource.data.data is string;
        allow delete: if signedIn() && request.auth.uid == hunterId;
      }

      // A hunter's position at each regular and speedhunt ping time, for the
      // round's map in the history (R-HIST-05). Nobody reads it while the
      // round runs – not even hunters; once it is over everyone may (like
      // all positions, R-GAME-06). One doc per hunter and slot, never edited.
      match /hunterSnaps/{snapId} {
        allow read: if isMember(gid) && roundOver(gid);
        allow create: if isRunning(gid) && isHunter(gid)
          && request.resource.data.keys().hasOnly(['uid', 'slot', 'createdAt', 'data'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.slot is string
          && snapId == request.auth.uid + '_' + request.resource.data.slot
          && request.resource.data.data is string;
      }

      // Live position of a player outside the play area (R-OUT-03): hunters
      // only, never other players (R-OUT-05). Written by the player's own
      // device while outside, deleted by it when back inside.
      match /outsideLocs/{playerId} {
        allow read: if isHunter(gid);
        allow create, update: if isRunning(gid) && isPlayer(gid)
          && request.auth.uid == playerId
          && request.resource.data.keys().hasOnly(['updatedAt', 'data'])
          && request.resource.data.data is string;
        allow delete: if signedIn() && request.auth.uid == playerId;
      }

      // Live position of a player still in the game, every 15 s, for game
      // masters and caught players only – never hunters or active players
      // (R-GM-04 … R-GM-07). Nothing is shared live once the round is over
      // (R-GM-09). Written and deleted by the player's own device.
      match /playerLocs/{playerId} {
        allow read: if watchesLive(gid) && !roundOver(gid);
        allow create, update: if isRunning(gid) && isPlayer(gid)
          && myMember(gid).get('caught', false) == false
          && !roundOver(gid)
          && request.auth.uid == playerId
          && request.resource.data.keys().hasOnly(['updatedAt', 'data'])
          && request.resource.data.data is string;
        allow delete: if signedIn() && request.auth.uid == playerId;
      }

      // Hunters' drawings on the map (R-DRAW-06): hunters only, never
      // players. Any hunter may erase any stroke; erasing replaces a stroke
      // by its remaining pieces (delete + create).
      match /drawings/{drawingId} {
        allow read: if isHunter(gid);
        allow create: if isRunning(gid) && isHunter(gid)
          && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'data'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.data is string
          && request.resource.data.data.size() < 200000;
        allow delete: if isHunter(gid);
      }

      // Catches (R-CATCH-01) and speedhunts (R-SPEED-02). Content encrypted;
      // a speedhunt event carries no target (R-SPEED-04).
      match /events/{eventId} {
        allow read: if isMember(gid);
        allow create: if isRunning(gid) && isMember(gid)
          && request.resource.data.keys().hasOnly(['type', 'createdAt', 'data'])
          && request.resource.data.data is string
          && (request.resource.data.type == 'catch'
            || (request.resource.data.type == 'speedhunt' && isHunter(gid)));
      }

      // Who a speedhunt targets: only hunters and the target may read it.
      match /speedhuntTargets/{eventId} {
        allow read: if isHunter(gid)
          || (isMember(gid) && resource.data.uid == request.auth.uid);
        allow create: if isRunning(gid) && isHunter(gid)
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid is string;
      }

      // Joker "player positions" (R-PLAY-03): a player asks, the other players'
      // devices answer with their position. Only possible together with
      // marking the joker as used (same batch, same server time).
      match /jokerRequests/{requestId} {
        allow read: if isPlayer(gid);
        allow create: if isRunning(gid) && isPlayer(gid)
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/games/$(gid)/members/$(request.auth.uid))
               .data.get('playerJokerAt', null) == request.time;
      }

      // Answers are readable only by the asking player; never by hunters.
      match /jokerAnswers/{answerId} {
        allow read: if signedIn() && resource.data.requester == request.auth.uid;
        allow create: if isRunning(gid) && isPlayer(gid)
          && request.resource.data.keys().hasOnly(['request', 'requester', 'uid', 'createdAt', 'data'])
          && request.resource.data.uid == request.auth.uid
          && answerId == request.resource.data.request + '_' + request.auth.uid
          && request.resource.data.data is string
          && get(/databases/$(database)/documents/games/$(gid)/jokerRequests/$(request.resource.data.request))
               .data.uid == request.resource.data.requester
          && request.resource.data.requester != request.auth.uid;
      }

      // Round summaries, kept across rounds (R-HIST-02); written by the host
      // when aborting a round – or by any member ending it automatically
      // (R-GAME-10) –, never edited, deleted by the host (R-HIST-06) or with
      // the group.
      match /history/{roundId} {
        allow read: if isMember(gid);
        allow create: if (isAdmin(gid) || canAutoEnd(gid))
          && request.resource.data.keys().hasOnly(['endedAt', 'data'])
          && request.resource.data.endedAt is timestamp
          && request.resource.data.data is string;
        allow delete: if isAdmin(gid) || isExpired(gid);
      }

      // The map of a round (all positions, encrypted, R-HIST-04), under the
      // id of its summary, which must exist first. Same writers as the
      // summary; every member may look at it; never edited.
      match /historyMaps/{roundId} {
        allow read: if isMember(gid);
        allow create: if (isAdmin(gid) || canAutoEnd(gid))
          && exists(/databases/$(database)/documents/games/$(gid)/history/$(roundId))
          && request.resource.data.keys().hasOnly(['endedAt', 'data'])
          && request.resource.data.endedAt is timestamp
          && request.resource.data.data is string;
        allow delete: if isAdmin(gid) || isExpired(gid);
      }
    }
  }
}
